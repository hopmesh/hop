{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["./tools/agent-output-plugin.mjs"],
  "environmentAllowlist": [
    "SSH_AUTH_SOCK"
  ],
  "permission": {
    "bash": {
      "env": "deny",
      "env -0*": "deny",
      "env --null*": "deny",
      "env |*": "deny",
      "env >*": "deny",
      "/bin/env": "deny",
      "/bin/env -0*": "deny",
      "/bin/env --null*": "deny",
      "/usr/bin/env": "deny",
      "/usr/bin/env -0*": "deny",
      "/usr/bin/env --null*": "deny",
      "printenv *": "deny",
      "/bin/printenv *": "deny",
      "/usr/bin/printenv *": "deny",
      "set": "deny",
      "export": "deny",
      "export --": "deny",
      "export -p*": "deny",
      "declare": "deny",
      "declare --": "deny",
      "declare -p*": "deny",
      "declare -x": "deny",
      "typeset": "deny",
      "typeset --": "deny",
      "typeset -p*": "deny",
      "typeset -x": "deny",
      "busybox env*": "deny",
      "*/busybox env*": "deny",
      "ssh * env*": "deny",
      "ssh * printenv*": "deny",
      "*/ssh * env*": "deny",
      "*/ssh * printenv*": "deny",
      "docker exec * env*": "deny",
      "docker exec * printenv*": "deny",
      "kubectl exec * env*": "deny",
      "kubectl exec * printenv*": "deny",
      "kubectl exec * -- env*": "deny",
      "kubectl exec * -- printenv*": "deny",
      "Get-ChildItem Env:*": "deny",
      "Get-Item Env:*": "deny",
      "gci Env:*": "deny",
      "gi Env:*": "deny",
      "adb shell env*": "deny",
      "adb * shell env*": "deny",
      "adb shell printenv*": "deny",
      "adb * shell printenv*": "deny",
      "*/adb shell env*": "deny",
      "*/adb * shell env*": "deny",
      "*/adb shell printenv*": "deny",
      "*/adb * shell printenv*": "deny",
      "xcrun simctl spawn * env*": "deny",
      "xcrun simctl spawn * *env*": "deny",
      "xcrun simctl spawn * launchctl getenv*": "deny",
      "*/xcrun simctl spawn * env*": "deny",
      "*/xcrun simctl spawn * *env*": "deny",
      "*/xcrun simctl spawn * launchctl getenv*": "deny"
    }
  }
}
