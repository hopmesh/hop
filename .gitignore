drivers/apple/HopDriver/Frameworks/
drivers/apple/HopDriver/Sources/HopFFIBindings/hop_ffi.swift
drivers/apple/HopDriver/.build-staging/
# ---- Rust ----
/target
# Every crate OUTSIDE the root workspace builds into its OWN target/, and these rules are anchored, so
# each one needs its own line. Missing them is not cosmetic: it silently stages thousands of build
# artifacts (this cost 8435 files in one commit before it was caught by reading the diffstat).
/fuzz/target
/services/hop-accountd/target
/services/hop-billingd/target
/fuzz/artifacts
/fuzz/coverage
**/*.rs.bk
# Python verification helpers
__pycache__/
*.py[cod]
# Node dependency trees
node_modules/
# relay identity seeds + on-disk stores (never commit secrets/state)
*.db
*.db.key

# ---- OpenTofu / Terraform ----
# State lives in GCS (the `backend "gcs"` blocks in infra/versions.tf, infra/billing/providers.tf,
# infra/bootstrap/versions.tf) and tfvars can carry credentials. Nothing matching these is tracked
# today; this stops a stray local `tofu` run from making one tracked by accident. The committed
# .terraform.lock.hcl files stay tracked on purpose (provider pinning) and are not matched here, and
# *.tfvars does not match the tracked terraform.tfvars.example templates.
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform/

# ---- macOS ----
.DS_Store

# ---- iOS / Xcode ----
# generated XCFramework + Swift bindings (legacy path + the HopDriver package)
# regenerate with xcodegen
*.xcodeproj
# xcodebuild output / DerivedData
apps/apple/HopDemo/build/
**/xcuserdata/

# ---- Android ----
apps/android/HopDemo/generated/
.gradle/
apps/android/HopDemo/.gradle/
apps/android/HopDemo/build/
apps/android/HopDemo/app/build/
apps/android/HopDemo/local.properties

# Local marketing-site preview renders
apps/web/site/.preview/

# libhop C smoke-test binary (build artifact; source is examples/smoke.c)
core/hop/examples/smoke

# SwiftPM build dirs for the SDK wrappers / bearer packages
sdk/apple/.build/
bearers/apple/**/.build/

# HopDemoKit (the demo app's pure, headlessly-tested logic) SwiftPM build dir
apps/apple/HopDemoKit/.build/

# Kotlin/JVM SDK build dirs
sdk/android/.gradle/
sdk/android/build/

# ESP32 example host binary
apps/esp32/hop-sensor/hop-sensor

# Apple driver build dir
drivers/apple/**/.build/

# libhop xcframework (gitignored artifact; build-xcframework.sh)
sdk/apple/Frameworks/

# Android bearer build artifacts
bearers/android/.gradle/
bearers/android/build/
bearers/android/**/build/
bearers/android/local.properties

# Kotlin SDK: machine-local gradle config + Kotlin daemon logs (never tracked)
sdk/android/local.properties
sdk/android/.kotlin/
sdk/android/build/

# Kotlin compile-daemon session scratch, wherever a Gradle build runs. Only sdk/android/ was
# listed, so a verify run under bearers/ or apps/android/ left an untracked .salive file that a
# `git add -A` will happily commit. Cover every tree that has a Gradle build.
.kotlin/
**/.kotlin/

# Android driver build
drivers/android/**/build/

# ---- WASM sim ----
# nodejs wasm-pack build for sim/scenario-check.mjs (build artifact; recipe: sim/build-wasm.sh).
# sim/pkg/ (the browser --target web build) stays committed so the Astro site builds without a wasm
# toolchain, but CI rebuilds it from source and fails on drift (web-05 / simwasm-02; sim/check-pkg-fresh.sh).
core/hop-wasm/pkg-node/
erl_crash.dump
