<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The BLE / Wi-Fi / foreground-service / notification / internet perms and the HopService
         declaration live in the :hop-driver library manifest and are merged in here. -->

    <!-- Scan a contact's QR code (zxing-android-embedded). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- android-r2-01/-04: no auto-backup. The on-disk chat/contact/channel mirrors are NOT gated out
         of any build; they are AES-256-GCM sealed at rest with the Keystore-wrapped db key (MirrorCrypto)
         in both debug and release. Keeping backup off is defense in depth so that neither the encrypted
         hop.db, the sealed mirrors, nor any debug-build data are ever uploaded to Google's off-device
         backup transport. -->
    <application
        android:name=".HopApp"
        android:label="Hop Demo Native"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- android-r2-03: the exported hopdemo:// automation deep link (a silent send-as-user
                 primitive any app/webpage could drive) is declared ONLY in the debug manifest overlay
                 (src/debug/AndroidManifest.xml), so a release APK does not export it at all. -->
        </activity>
    </application>
</manifest>
