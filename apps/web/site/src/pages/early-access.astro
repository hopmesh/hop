---
// Developer preview onboarding page. Explains testnet and developer preview status
// before directing users to the dashboard.
import Base from '../layouts/Base.astro';

const CONSOLE = 'https://dashboard.hopme.sh/';
---
<Base
  title="Start free on Hop"
  description="Hop is open. Create a free account, get your keys, and start building on the mesh."
  path="/early-access"
>
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">Developer preview</div>
      <h1>Testnet &amp; developer <span style="color:var(--accent)">preview.</span></h1>
      <p class="lede">Hop is open for developer preview and testnet evaluation. Client SDKs and peer-to-peer protocols are fully operational, while the managed cloud relay fleet is undergoing staged bring-up. Create a developer account and test integrations across local and hosted transports.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href={CONSOLE}>Start free →</a>
        <a class="btn btn-ghost" href="/docs/quickstart/">Read the quickstart</a>
      </div>
      <p class="note mt-m">Access the developer console at <a href={CONSOLE}>dashboard.hopme.sh</a> to manage your keys and view usage. Building something unusual, or need a private fleet or a
         commercial license? Write <a href="mailto:hello@hopme.sh">hello@hopme.sh</a>.</p>
    </div>
  </section>
</Base>

