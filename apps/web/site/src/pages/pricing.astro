---
import Base from '../layouts/Base.astro';
---
<Base
  title="Hop pricing, two usage meters, free P2P and self-host"
  description="Hop bills two things: reach (backbone delivery to offline recipients, $0.002 each) and telemetry ($0.30 per million events). Direct connections, pure P2P, and self-hosting are free. Model your bill with the live calculator."
  path="/pricing"
>
  <!-- hero -->
  <section class="hero" style="padding-bottom:20px;">
    <div class="wrap">
      <div class="eyebrow">Pricing</div>
      <h1>You pay for <span class="c-reach">reach</span> and <span class="grad">telemetry</span>. Nothing else.</h1>
      <p class="lede">
        Two usage meters, both measured at our own edge so they can't be gamed. Direct
        connections, pure peer-to-peer, and self-hosting the whole fabric are free. No
        per-seat tax: you pay for the backbone we actually carry and the telemetry we
        actually collect.
      </p>
      <div class="hero-meta">
        <span class="tag"><b class="c-reach">Reach</b> $0.002 / offline delivery</span>
        <span class="tag"><b class="c-tel">Telemetry</b> $0.30 / 1M events</span>
        <span class="tag">P2P &middot; direct &middot; self-host <b>free</b></span>
      </div>
    </div>
  </section>

  <!-- the two meters -->
  <section class="band" style="padding-top:44px;">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">The two meters</div>
        <h2>Metered where we can see them.</h2>
        <p>Not on the device, not self-reported. We bill only what crosses our infrastructure,
           which is also the only thing that costs us anything.</p>
      </div>
      <div class="grid-2 meters">
        <div class="meter reach">
          <div class="ic"><i class="fa-duotone fa-solid fa-tower-broadcast"></i></div>
          <div class="mk">Reach</div>
          <div class="price">$0.002</div>
          <div class="unit">per backbone delivery to an offline recipient</div>
          <p>We carried a bundle across the relay fleet and delivered it to someone who was&nbsp;<strong>offline</strong>. This is the thing Hop uniquely does, and the only message
             traffic that ever bills. Measured at the relay, on proof of delivery.</p>
          <div class="mrow">
            <div><span>Free tier</span><b>10,000 / mo</b></div>
            <div><span>Billed on</span><b>proven delivery</b></div>
            <div><span>Direct / P2P</span><b>never billed</b></div>
          </div>
        </div>
        <div class="meter tel">
          <div class="ic"><i class="fa-duotone fa-solid fa-satellite-dish"></i></div>
          <div class="mk">Telemetry</div>
          <div class="price">$0.30</div>
          <div class="unit">per 1,000,000 events, translated to OTLP</div>
          <p>We collected your device stats over the mesh, translated our compact wire format to&nbsp;<strong>true OTLP</strong>, and forwarded them to your stack or our console. Priced
             per record, so it scales with how chatty a device is. No tiers to classify.</p>
          <div class="mrow">
            <div><span>Free tier</span><b>25M events / mo</b></div>
            <div><span>We store</span><b>counts only</b></div>
            <div><span>Self-host</span><b>free, on you</b></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- calculator -->
  <section class="band band-soft">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Model your bill</div>
        <h2>What would it cost you?</h2>
        <p>Start from a use case or drag the inputs. Live, using the exact rate card above.
           Reach is driven by the share of your fleet that has no connectivity, the people
           only the backbone can reach.</p>
      </div>

      <div class="calc">
        <div class="uc-chips" id="ucChips" role="group" aria-label="Use cases">
          <button class="uc" data-uc="gig"><i class="fa-solid fa-people-group"></i> Gig marketplace</button>
          <button class="uc" data-uc="mining"><i class="fa-solid fa-helmet-safety"></i> Mining / industrial</button>
          <button class="uc" data-uc="events"><i class="fa-solid fa-ticket"></i> Live events</button>
          <button class="uc" data-uc="logistics"><i class="fa-solid fa-truck"></i> Logistics / fleet</button>
          <button class="uc" data-uc="field"><i class="fa-solid fa-tower-cell"></i> Field ops / disaster</button>
        </div>

        <div class="calc-grid">
          <div class="calc-in">
            <div class="fld">
              <div class="fl"><label for="dev">Monthly active devices</label><span class="fv" id="devV">50,000</span></div>
              <input class="rng" type="range" id="dev" min="1000" max="500000" step="1000" value="50000">
            </div>
            <div class="fld">
              <div class="fl"><label for="msg">Messages per device / month</label><span class="fv" id="msgV">200</span></div>
              <input class="rng" type="range" id="msg" min="10" max="1000" step="10" value="200">
            </div>
            <div class="fld">
              <div class="fl"><label for="off">Devices without connectivity</label><span class="fv" id="offV">5%</span></div>
              <input class="rng" type="range" id="off" min="0" max="100" step="1" value="5">
              <div class="hint">The share you can only reach over the backbone. Everyone else rides direct or local P2P, free.</div>
            </div>
            <div class="fld">
              <div class="fl"><label>Telemetry intensity</label></div>
              <div class="seg" id="intSeg" role="group" aria-label="Telemetry intensity">
                <button data-int="light" aria-pressed="false">Light<span>15K</span></button>
                <button data-int="standard" aria-pressed="true">Standard<span>40K</span></button>
                <button data-int="heavy" aria-pressed="false">Heavy<span>200K</span></button>
              </div>
            </div>
            <div class="fld" style="margin-bottom:0;">
              <div class="fl"><label>Deployment</label></div>
              <div class="seg two" id="depSeg" role="group" aria-label="Deployment">
                <button data-dep="managed" aria-pressed="true">Managed</button>
                <button data-dep="self" aria-pressed="false">Self-host</button>
              </div>
            </div>
          </div>

          <div class="calc-out">
            <div class="oh">Estimated monthly</div>
            <div class="ro reach">
              <span class="sw"></span>
              <div class="rb"><div class="rt"><span>Reach</span><b id="reachAmt">$0</b></div><div class="rm" id="reachMeta">0 deliveries</div></div>
            </div>
            <div class="ro tel">
              <span class="sw"></span>
              <div class="rb"><div class="rt"><span>Telemetry</span><b id="telAmt">$0</b></div><div class="rm" id="telMeta">0 events</div></div>
            </div>
            <div class="splitbar"><i class="sr" id="barR"></i><i class="st" id="barT"></i></div>
            <div class="total">
              <div class="tl">Total<div class="per" id="perDev">$0.00 / device</div></div>
              <div class="tbig" id="totalAmt">$0<small id="yr"></small></div>
            </div>
            <div class="sh-note" id="shNote">You run the relay and collector yourself. We bill nothing, and your telemetry never leaves your infrastructure. Your only cost is the cloud you run it on.</div>
          </div>
        </div>
        <div class="calc-foot">
          <span>Reach $0.002 / delivery &middot; free 10K &nbsp;|&nbsp; Telemetry $0.30 / 1M &middot; free 25M</span>
          <span id="footNums" class="mono"></span>
        </div>
      </div>
      <p class="note mt-m center">Plus egress at $0.15 / GB and mailbox storage at $0.40 / GB-month past your
         allowance, usually minor. Figures are illustrative, the model we're finalizing for general
         availability, and move with your fleet's connectivity and telemetry cadence.</p>
    </div>
  </section>

  <!-- self-host vs managed -->
  <section class="band">
    <div class="wrap">
      <div class="section-head">
        <div class="eyebrow">Two ways to run it</div>
        <h2>Own the infrastructure, or let us.</h2>
      </div>
      <div class="grid-2">
        <div class="card">
          <div class="hostrow"><h3>Self-host</h3><span class="ptag free">$0</span></div>
          <p class="mt-s">Run the relay and telemetry collector yourself. The services are
             licensed&nbsp;<span class="mono" style="color:var(--accent)">Apache-2.0</span>,
             with no restriction on running them for your own use. The protocol core they embed is
             source-available under&nbsp;<span class="mono" style="color:var(--accent)">FSL-1.1-ALv2</span>,
             which converts to Apache-2.0 after two years.</p>
          <ul class="checks">
            <li>Zero fees, full data sovereignty. Telemetry never leaves your infrastructure.</li>
            <li>Same protocol, same mesh, same delivery guarantees.</li>
            <li class="x">No single pane of glass. You build your own interface on the raw OTLP, and you run the ops.</li>
          </ul>
        </div>
        <div class="card lit">
          <div class="hostrow"><h3>Managed</h3><span class="ptag paid">Usage-based</span></div>
          <p class="mt-s">We run the fabric. You pay the two meters and get what self-host doesn't,
             which is the actual reason to pay.</p>
          <ul class="checks">
            <li><strong>Single pane of glass</strong>: billing, mesh topology, and observability in one console.</li>
            <li><strong>OTLP export</strong> straight into Datadog, Grafana, Honeycomb, whatever you already run.</li>
            <li>Optional <strong>prepaid commits</strong> for a predictable, budgetable number.</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- fail-open -->
  <section class="band band-soft">
    <div class="wrap">
      <div class="grid-2" style="align-items:center; gap:40px;">
        <div>
          <div class="eyebrow">Fail-open by design</div>
          <h2>The mesh never goes below free.</h2>
          <p class="mt-s">Billing observes the network, it never gates it. A spending limit can't
             take your delivery down, which is exactly what a safety or field deployment needs to
             hear. Metering is asynchronous and downstream, so it physically cannot stop a live
             message.</p>
          <p class="mt-s">The paid backbone is the only thing that can ever pause, and it pauses&nbsp;<em>up to</em>&nbsp;free, never below.</p>
        </div>
        <div class="ladder">
          <div class="rung">
            <div class="ri"><i class="fa-duotone fa-solid fa-bullseye"></i></div>
            <div><h3>Hit your budget cap</h3><p>We alert you, keep delivering, and bill the overage or let you raise it. Never a kill-switch.</p></div>
          </div>
          <div class="rung">
            <div class="ri"><i class="fa-duotone fa-solid fa-circle-nodes"></i></div>
            <div><h3>Suspend the account</h3><p>The relay stops carrying your traffic, but P2P and direct connections keep working. You land on exactly the free tier, never less.</p></div>
          </div>
          <div class="rung">
            <div class="ri"><i class="fa-duotone fa-solid fa-paper-plane"></i></div>
            <div><h3>Anything in flight</h3><p>Bundles already accepted or spooled always deliver, even for an over-budget or suspended account. We never drop a message you handed us.</p></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- cta -->
  <section class="cta-band">
    <div class="wrap">
      <h2>Build for free. Pay only for reach and telemetry.</h2>
      <p>P2P and direct connections are always free. Start on the SDK, add the managed backbone when you need to reach the disconnected.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="https://dashboard.hopme.sh/">Start free</a>
        <a class="btn btn-ghost" href="/docs/quickstart/">See the docs</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* meter accents drawn from the site palette: telemetry = signal green, reach = in-transit blue */
  .c-reach { color: var(--accent-3); }
  .c-tel { color: var(--accent); }

  /* ---- two meters ---- */
  .meters .meter {
    position: relative; padding: 30px; border-radius: var(--radius);
    border: 1px solid var(--line); background: var(--panel); overflow: hidden;
  }
  .meters .meter::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; }
  .meter.reach::before { background: var(--accent-3); }
  .meter.tel::before { background: var(--accent); }
  .meter .ic {
    width: 46px; height: 46px; border-radius: 12px; display: grid; place-items: center;
    font-size: 20px; margin-bottom: 18px; background: var(--panel-2); border: 1px solid var(--line);
  }
  .meter.reach .ic { --fa-primary-color: var(--accent-3); --fa-secondary-color: var(--accent-3); }
  .meter.reach .ic i { color: var(--accent-3); }
  .meter .mk { font: 600 12px/1 var(--mono); letter-spacing: .18em; text-transform: uppercase; color: var(--ink-dim); }
  .meter.reach .mk { color: var(--accent-3); } .meter.tel .mk { color: var(--accent); }
  .meter .price { font: 780 clamp(34px,5vw,46px)/1 var(--mono); letter-spacing: -.02em; margin: 14px 0 3px; }
  .meter .unit { font-size: 14px; color: var(--ink-mut); }
  .meter p { font-size: 14.5px; margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--line-soft); }
  .meter .mrow { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 16px; }
  .meter .mrow span { display: block; font-size: 12px; color: var(--ink-mut); }
  .meter .mrow b { font: 600 14px/1.3 var(--mono); color: var(--ink); }

  /* ---- calculator ---- */
  .calc { border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--panel); }
  .uc-chips { display: flex; flex-wrap: wrap; gap: 8px; padding: 20px 22px; border-bottom: 1px solid var(--line-soft); }
  .uc {
    font: 600 13px/1 var(--sans); color: var(--ink-dim); cursor: pointer;
    border: 1px solid var(--line); background: var(--bg-soft); padding: 8px 13px; border-radius: 999px;
    display: inline-flex; align-items: center; gap: 8px; transition: border-color .14s, color .14s, background .14s;
  }
  .uc i { color: var(--ink-mut); font-size: 12px; }
  .uc:hover { color: var(--ink); border-color: #3a4248; }
  .uc[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .uc[aria-pressed="true"] i { color: var(--accent-ink); }

  .calc-grid { display: grid; grid-template-columns: 1.05fr .95fr; }
  .calc-in { padding: 28px; border-right: 1px solid var(--line-soft); }
  .calc-out { padding: 28px; background: var(--bg-soft); }
  .fld { margin-bottom: 24px; }
  .fl { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 11px; }
  .fl label { font: 600 13.5px/1 var(--sans); color: var(--ink-dim); }
  .fl .fv { font: 600 15px/1 var(--mono); color: var(--ink); font-variant-numeric: tabular-nums; }
  .hint { font-size: 12px; color: var(--ink-mut); margin-top: 9px; line-height: 1.5; }

  .rng { -webkit-appearance: none; appearance: none; width: 100%; height: 5px; border-radius: 5px; background: var(--line); outline: none; }
  .rng::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 20px; height: 20px; border-radius: 50%;
    background: var(--accent); border: 3px solid var(--panel); box-shadow: 0 0 0 1px var(--line), 0 2px 8px #00000055; cursor: pointer; transition: transform .1s; }
  .rng::-webkit-slider-thumb:hover { transform: scale(1.08); }
  .rng::-moz-range-thumb { width: 20px; height: 20px; border-radius: 50%; background: var(--accent);
    border: 3px solid var(--panel); box-shadow: 0 0 0 1px var(--line); cursor: pointer; }
  .rng:focus-visible::-webkit-slider-thumb { outline: 2px solid var(--accent); outline-offset: 2px; }

  .seg { display: flex; gap: 6px; background: var(--bg-soft); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 4px; }
  .seg button { flex: 1; appearance: none; background: none; border: none; border-radius: 7px; padding: 10px 6px; cursor: pointer;
    color: var(--ink-dim); font: 600 13px/1.25 var(--sans); display: flex; flex-direction: column; align-items: center; gap: 3px; transition: background .14s, color .14s; }
  .seg button span { font: 400 10.5px/1 var(--mono); color: var(--ink-mut); }
  .seg button[aria-pressed="true"] { background: var(--panel); color: var(--ink); box-shadow: 0 1px 0 #ffffff08, 0 6px 16px -10px #000000aa; }
  .seg.two button { padding: 12px 6px; font-size: 13.5px; }

  .oh { font: 600 11.5px/1 var(--mono); letter-spacing: .2em; text-transform: uppercase; color: var(--ink-mut); margin-bottom: 20px; }
  .ro { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
  .ro .sw { width: 9px; height: 34px; border-radius: 3px; flex: none; }
  .ro.reach .sw { background: var(--accent-3); } .ro.tel .sw { background: var(--accent); }
  .ro .rb { flex: 1; min-width: 0; }
  .ro .rt { display: flex; justify-content: space-between; gap: 8px; font: 600 13px/1.3 var(--sans); color: var(--ink-dim); }
  .ro .rt b { font: 600 16px/1 var(--mono); color: var(--ink); font-variant-numeric: tabular-nums; }
  .ro .rm { font: 400 11px/1.3 var(--mono); color: var(--ink-mut); margin-top: 3px; }
  .splitbar { height: 8px; border-radius: 5px; overflow: hidden; display: flex; background: var(--line); margin: 20px 0; }
  .splitbar i { display: block; height: 100%; transition: width .2s ease; }
  .splitbar .sr { background: var(--accent-3); } .splitbar .st { background: var(--accent); }
  .total { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; border-top: 1px solid var(--line-soft); padding-top: 20px; }
  .total .tl { font: 600 13px/1.3 var(--sans); color: var(--ink-dim); }
  .total .per { font: 400 11.5px/1 var(--mono); color: var(--ink-mut); margin-top: 5px; }
  .total .tbig { font: 780 clamp(30px,4.4vw,42px)/1 var(--mono); letter-spacing: -.02em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .total .tbig small { font: 400 14px/1 var(--sans); color: var(--ink-mut); margin-left: 6px; }
  .sh-note { display: none; margin-top: 18px; font-size: 13px; line-height: 1.5; color: var(--ink-dim);
    background: color-mix(in srgb, var(--accent-3) 8%, transparent); border: 1px solid color-mix(in srgb, var(--accent-3) 26%, transparent); border-radius: var(--radius-sm); padding: 12px 14px; }
  .sh-note.on { display: block; }
  .calc-foot { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap;
    padding: 15px 22px; border-top: 1px solid var(--line-soft); font: 400 12px/1.4 var(--mono); color: var(--ink-mut); }

  /* ---- host cards ---- */
  .hostrow { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .ptag { font: 600 13px/1 var(--mono); padding: 6px 12px; border-radius: 999px; }
  .ptag.free { color: var(--accent-3); background: color-mix(in srgb, var(--accent-3) 12%, transparent); }
  .ptag.paid { color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .checks li.x { padding-left: 24px; }
  .checks li.x::before { content: "\00d7"; color: var(--ink-mut); }

  /* ---- fail-open ladder ---- */
  .ladder { display: grid; gap: 12px; }
  .rung { display: flex; gap: 16px; align-items: flex-start; padding: 20px 22px; border: 1px solid var(--line); border-radius: var(--radius-sm); background: var(--panel); }
  .rung .ri { width: 40px; height: 40px; border-radius: 11px; display: grid; place-items: center; font-size: 17px; flex: none;
    background: var(--panel-2); border: 1px solid var(--line); }
  .rung h3 { font-size: 15.5px; margin-bottom: 4px; }
  .rung p { font-size: 13.5px; }

  @media (max-width: 880px) {
    .meters, .grid-2 { grid-template-columns: 1fr; }
    .calc-grid { grid-template-columns: 1fr; }
    .calc-in { border-right: none; border-bottom: 1px solid var(--line-soft); }
  }
</style>

<script is:inline>
  (function () {
    var M = { reachPrice: 0.002, reachFree: 10000, telPer: 0.30 / 1e6, telFree: 25e6,
              intensity: { light: 15000, standard: 40000, heavy: 200000 } };
    var UC = {
      gig:       { dev: 300000, msg: 200, off: 5,  int: 'light' },
      mining:    { dev: 8000,   msg: 400, off: 2,  int: 'heavy' },
      events:    { dev: 50000,  msg: 120, off: 8,  int: 'light' },
      logistics: { dev: 50000,  msg: 150, off: 4,  int: 'heavy' },
      field:     { dev: 2500,   msg: 300, off: 80, int: 'standard' }
    };
    var s = { dev: 50000, msg: 200, off: 5, int: 'standard', dep: 'managed' };
    var $ = function (id) { return document.getElementById(id); };
    if (!$('dev')) return;

    function usd(n) { if (n === 0) return '$0'; if (n < 10) return '$' + n.toFixed(2); if (n < 1000) return '$' + n.toFixed(0); return '$' + Math.round(n).toLocaleString(); }
    function big(n) { n = Math.round(n);
      if (n >= 1e9) { var b = n / 1e9; return (b >= 10 ? b.toFixed(0) : b.toFixed(1)) + 'B'; }
      if (n >= 1e6) { var m = n / 1e6; return (m >= 10 ? m.toFixed(0) : m.toFixed(1)) + 'M'; }
      if (n >= 1e3) return Math.round(n / 1e3) + 'K';
      return String(n); }

    function render() {
      var events = s.dev * M.intensity[s.int];
      var tel = Math.max(0, events - M.telFree) * M.telPer;
      var deliveries = Math.round(s.dev * s.msg * (s.off / 100));
      var reach = Math.max(0, deliveries - M.reachFree) * M.reachPrice;
      var managed = s.dep === 'managed';
      var total = managed ? tel + reach : 0;

      $('devV').textContent = s.dev.toLocaleString();
      $('msgV').textContent = s.msg;
      $('offV').textContent = s.off + '%';

      $('reachAmt').textContent = managed ? usd(reach) : '$0';
      $('telAmt').textContent = managed ? usd(tel) : '$0';
      $('reachMeta').textContent = big(deliveries) + ' offline deliveries · ' + big(Math.min(deliveries, M.reachFree)) + ' free';
      $('telMeta').textContent = big(events) + ' events · ' + big(Math.min(events, M.telFree)) + ' free';

      var sum = (reach + tel) || 1;
      $('barR').style.width = (managed ? reach / sum * 100 : 0) + '%';
      $('barT').style.width = (managed ? tel / sum * 100 : 0) + '%';

      $('totalAmt').firstChild.textContent = usd(total);
      $('yr').textContent = ' · ' + usd(total * 12) + '/yr';
      var pd = total > 0 ? (total / s.dev) : 0;
      $('perDev').textContent = (pd > 0 ? '$' + pd.toFixed(pd < 0.1 ? 4 : 3) : '$0.00') + ' / device';
      $('footNums').textContent = big(events) + ' events · ' + big(deliveries) + ' reach';
      $('shNote').classList.toggle('on', !managed);
    }

    function pressed(group, attr, val) {
      Array.prototype.forEach.call($(group).querySelectorAll('button'), function (b) {
        b.setAttribute('aria-pressed', b.getAttribute(attr) === val ? 'true' : 'false');
      });
    }
    function clearUc() { Array.prototype.forEach.call($('ucChips').querySelectorAll('.uc'), function (b) { b.setAttribute('aria-pressed', 'false'); }); }

    $('dev').addEventListener('input', function (e) { s.dev = +e.target.value; clearUc(); render(); });
    $('msg').addEventListener('input', function (e) { s.msg = +e.target.value; clearUc(); render(); });
    $('off').addEventListener('input', function (e) { s.off = +e.target.value; clearUc(); render(); });
    $('intSeg').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; s.int = b.getAttribute('data-int'); pressed('intSeg', 'data-int', s.int); clearUc(); render(); });
    $('depSeg').addEventListener('click', function (e) { var b = e.target.closest('button'); if (!b) return; s.dep = b.getAttribute('data-dep'); pressed('depSeg', 'data-dep', s.dep); render(); });
    $('ucChips').addEventListener('click', function (e) {
      var b = e.target.closest('.uc'); if (!b) return;
      var p = UC[b.getAttribute('data-uc')];
      s.dev = p.dev; s.msg = p.msg; s.off = p.off; s.int = p.int;
      $('dev').value = p.dev; $('msg').value = p.msg; $('off').value = p.off;
      pressed('intSeg', 'data-int', s.int);
      clearUc(); b.setAttribute('aria-pressed', 'true');
      render();
    });

    render();
  })();
</script>
