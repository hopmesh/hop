---
import Base from '../../layouts/Base.astro';
import { Content } from '../../../../../../docs/legal/eu-scc-package.md';
---
<Base
  title="EU Standard Contractual Clauses (SCC) Template Package"
  description="Standard Contractual Clauses (SCCs) template package for international data transfers under GDPR."
  path="/legal/eu-scc-package"
>
  <section class="hero" style="padding-bottom:16px;">
    <div class="wrap">
      <div class="eyebrow">Legal documentation</div>
      <h1>EU Standard Contractual Clauses <span style="color:var(--accent)">(SCC) Template.</span></h1>
    </div>
  </section>

  <section class="band" style="padding-top:24px;">
    <div class="wrap prose">
      <Content />
    </div>
  </section>
</Base>
