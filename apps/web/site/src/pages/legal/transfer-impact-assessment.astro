---
import Base from '../../layouts/Base.astro';
import { Content } from '../../../../../../docs/legal/transfer-impact-assessment.md';
---
<Base
  title="Transfer Impact Assessment (TIA)"
  description="Transfer Impact Assessment (TIA) evaluating cross-border data transfers and cryptographic safeguards under GDPR."
  path="/legal/transfer-impact-assessment"
>
  <section class="hero" style="padding-bottom:16px;">
    <div class="wrap">
      <div class="eyebrow">Legal documentation</div>
      <h1>Transfer Impact <span style="color:var(--accent)">Assessment (TIA).</span></h1>
    </div>
  </section>

  <section class="band" style="padding-top:24px;">
    <div class="wrap prose">
      <Content />
    </div>
  </section>
</Base>
