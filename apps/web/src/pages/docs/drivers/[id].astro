---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { drivers } from '../../../data/drivers.js';

export function getStaticPaths() {
  return drivers.map((h, i) => ({
    params: { id: h.id },
    props: { h, prev: drivers[(i - 1 + drivers.length) % drivers.length], next: drivers[(i + 1) % drivers.length] },
  }));
}
const { h, prev, next } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<DocsLayout
  title={`${h.name} driver, Hop docs`}
  description={`${h.name}: ${h.tagline}. ${h.summary}`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hopme.sh/' },
        { '@type': 'ListItem', position: 2, name: 'Docs', item: 'https://hopme.sh/docs/' },
        { '@type': 'ListItem', position: 3, name: `${h.name} driver`, item: canonical },
      ]},
      { '@type': 'TechArticle', headline: `${h.name} driver, Hop docs`, description: h.summary,
        url: canonical, isPartOf: { '@id': 'https://hopme.sh/#website' }, publisher: { '@id': 'https://hopme.sh/#org' } },
    ],
  })} />

  <div class="eyebrow"><a href="/docs/" style="color:var(--accent)">Docs</a> · Drivers</div>
  <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-top:10px;">
    <h1 style="margin:0;">{h.name}</h1>
    <span class:list={["status", { dev: h.status !== 'Available' }]}>{h.status}</span>
  </div>
  <p class="lede">{h.tagline}</p>
  <p>{h.summary}</p>

  <h2>Bearers it drives</h2>
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;">
    {h.bearers.map((b) => <span class="lchip">{b}</span>)}
  </div>

  <h2>How this driver works</h2>
  <ul class="checks">
    {h.notes.map((n) => <li set:html={n}></li>)}
  </ul>

  {h.refs && (
    <>
      <h2>Related</h2>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;">
        {h.refs.map(([label, href]) => <a class="lchip" href={href}>{label}</a>)}
      </div>
    </>
  )}

  <div class="prevnext" style="display:flex;justify-content:space-between;gap:16px;margin-top:44px;border-top:1px solid var(--line-soft);padding-top:22px;">
    <a class="link-go" href={`/docs/drivers/${prev.id}/`}>← {prev.name}</a>
    <a class="link-go" href={`/docs/drivers/${next.id}/`}>{next.name} →</a>
  </div>
</DocsLayout>
