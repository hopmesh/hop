---
import Base from '../../layouts/Base.astro';
import { cases } from '../../data/use-cases.js';
---
<Base
  title="Use cases, what you build on Hop"
  description="Messaging, offline-first data sync, file & media transfer, offline web, telemetry, and field response, all on one end-to-end encrypted, store-and-forward mesh transport."
  path="/use-cases"
>
  <section class="hero" style="padding-bottom:24px;">
    <div class="wrap">
      <div class="eyebrow">Use cases</div>
      <h1>What you build <span style="color:var(--accent)">on Hop.</span></h1>
      <p class="lede">One sealed, store-and-forward fabric, many things to build on it, because the
         hard part (the transport) is done once, for every app.</p>
    </div>
  </section>

  <section class="band" style="padding-top:8px;">
    <div class="wrap">
      <div class="scenes">
        {cases.map((c) => (
          <a class="scene" href={`/use-cases/${c.id}/`}>
            <img src={c.hero} alt={c.title.replace(/&amp;/g, '&')} width="1280" height="853" loading="lazy" />
            <div class="ov">
              <h3 set:html={c.title}></h3>
              <p set:html={c.tagline}></p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>Build it on the fabric.</h2>
      <p>The transport is done. Bring your app.</p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/docs/quickstart/">Quickstart →</a>
        <a class="btn btn-ghost" href="/protocol/">Read the protocol</a>
      </div>
    </div>
  </section>
</Base>
