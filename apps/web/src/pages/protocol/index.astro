---
import Base from '../../layouts/Base.astro';
import { layers, groups } from '../../data/protocol.js';
---
<Base
  title="Protocol, the Hop stack by layer"
  description="The Hop stack by layer: hdp (the datagram waist), hops, hps, streams, HNS, and the bearers below, each with a visual of how it works."
  path="/protocol"
>
  <section class="hero" style="padding-bottom:24px;">
    <div class="wrap">
      <div class="eyebrow">Protocol</div>
      <h1>The protocol, <span style="color:var(--accent)">by layer.</span></h1>
      <p class="lede">A map of the stack, the datagram waist, the semantics above it, and the bearers
         below. Open any layer for a visual of how it works. Deeper detail is coming in the Hop whitepaper.</p>
    </div>
  </section>

  <section style="padding:0;">
    <img class="band-img band-dark" src="/band-protocol.jpg" alt="A network topology narrowing through a single waist, many apps above, many bearers below" width="1920" height="823" loading="eager"
      style="width:100%;max-height:360px;object-fit:cover;border-top:1px solid var(--line);border-bottom:1px solid var(--line);" />
    <img class="band-img band-light" src="/band-protocol-light.jpg" alt="A network topology narrowing through a single waist, many apps above, many bearers below" width="1920" height="823" loading="eager"
      style="width:100%;max-height:360px;object-fit:cover;border-top:1px solid var(--line);border-bottom:1px solid var(--line);" />
  </section>

  {groups.map((g) => (
    <section class="band" style="padding-top:18px;padding-bottom:18px;">
      <div class="wrap">
        <div class="eyebrow">{g}</div>
        <div class="grid-2" style="margin-top:16px;">
          {layers.filter((l) => l.group === g).map((l) => (
            <a class="card" href={`/protocol/${l.id}/`} style="display:flex;align-items:center;justify-content:space-between;gap:16px;">
              <div>
                <h3 class:list={[{ mono: l.mono }]} set:html={l.name}></h3>
                <p class="muted" style="margin-top:4px;font-size:14px;" set:html={l.tagline}></p>
              </div>
              <span class="link-go" style="white-space:nowrap;">Open →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="cta-band">
    <div class="wrap">
      <h2>Ready to build on it?</h2>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/docs/quickstart/">Quickstart →</a>
        <a class="btn btn-ghost" href="/use-cases/">Use cases</a>
      </div>
    </div>
  </section>
</Base>
