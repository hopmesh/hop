{
  "name": "hopdemo-rn",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "react-native start",
    "test": "jest",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:build:android": "detox build -c android.emu.debug",
    "e2e:ios": "detox test --configuration ios.sim.debug",
    "e2e:android": "detox test -c android.emu.debug",
    "e2e:guard": "jest e2e/testids.test.js",
    "e2e:dry": "cucumber-js --dry-run  # informational only: cannot fail, see cucumber.js",
    "e2e:android:smoke": "detox test -c android.emu.debug -- --profile smoke",
    "e2e:multi": "cucumber-js --profile multi --dry-run"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native": "0.87.0",
    "@react-native/new-app-screen": "0.87.0",
    "react-native-safe-area-context": "^5.5.2",
    "@hop-mesh/react-native": "file:../../../sdk/react-native"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3",
    "detox": "20.28.0",
    "@cucumber/cucumber": "11.3.0",
    "ts-node": "10.9.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "detox": {
    "testRunner": {
      "args": {
        "$0": "cucumber-js"
      }
    }
  }
}
