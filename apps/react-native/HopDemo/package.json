{
  "name": "hopdemo-rn",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:build:android": "detox build -c android.emu.debug",
    "e2e:ios": "detox test --configuration ios.sim.debug",
    "e2e:android": "npm run e2e:preflight && detox test -c android.attached.debug",
    "e2e:guard": "jest e2e/testids.test.js",
    "e2e:dry": "cucumber-js --dry-run  # informational only: cannot fail, see cucumber.js",
    "e2e:android:smoke": "npm run e2e:preflight && detox test -c android.attached.debug -- --profile smoke",
    "e2e:multi": "cucumber-js --profile multi --dry-run",
    "e2e:pair": "node e2e/pair/run-pair.mjs",
    "e2e:pair:android": "node e2e/pair/run-pair.mjs --a android.attached.debug --b android.emu.debug --relay local",
    "e2e:preflight": "node e2e/preflight.mjs"
  },
  "dependencies": {
    "@hop-mesh/react-native": "file:../../../sdk/react-native",
    "@react-native/new-app-screen": "0.87.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-vector-icons": "^10.3.0",
    "react-navigation": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@cucumber/cucumber": "11.3.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "detox": "^20.51.4",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "ts-node": "10.9.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "detox": {
    "testRunner": {
      "args": {
        "$0": "cucumber-js"
      }
    }
  }
}
