# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# iOS 16.0, not React Native's min_ios_version_supported (15.1). The Hop Apple SDK declares iOS 16 in
# Package.swift and its podspecs say the same, so CocoaPods refuses to resolve the graph at 15.1 with
# "Specs satisfying the `Hop` dependency were found, but they required a higher minimum deployment target".
# Raising it here is the honest floor for an app that links Hop.
platform :ios, '16.0'
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'HopDemo' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # THE WHOLE HOP GRAPH, one pod per module, every one of them a `:path` development pod.
  #
  # `:path` is not a preference here, it is the only mechanism that works. `git ls-remote --tags origin`
  # returns NO TAGS, so the `:tag => "v0.0.2"` in every one of these podspecs' `s.source` cannot be
  # downloaded, which rules out `:podspec` for all of them. Two of the artifacts below are gitignored
  # build outputs anyway (HopFFI.xcframework and the generated hop.swift), so no tag could ever carry
  # them. `:path` ignores `s.source` entirely and reads the working tree, which is also what this app
  # wants: it is developing the driver, not consuming a release of it.
  #
  # Each podspec lives beside the Package.swift it mirrors, so each `:path` is that package's root.
  #
  # EXACTLY ONE POD VENDORS THE HOP CORE: HopFFIBindings, from
  # drivers/apple/HopDriver/Frameworks/HopFFI.xcframework, the SQLCipher build produced by
  # tools/build-xcframework.sh. CHop used to fetch the pinned libhop.xcframework release asset and now
  # carries only the `CHop` module face, depending on HopFFIBindings for the library. That is not tidying:
  # both archives are named libhop.a and both export the same 257 hop/uniffi/ffi symbols, while CocoaPods
  # emits a single -l"hop" for this target. With both present that one flag silently resolves to whichever
  # search path sorts first, and the release asset is the build with no SQLCipher, so the driver's
  # encrypted store would quietly become plaintext. The podspecs carry the nm measurements.
  # CHop carries no files at all now: the `CHop` module map ships inside the xcframework HopFFIBindings
  # vendors, beside the `hopFFI` one, so both faces resolve against a single libhop.a. Its podspec records
  # why a header-only pod cannot supply that module.
  pod 'CHop', :path => '../../../../sdk/apple'
  pod 'HopContract', :path => '../../../../sdk/apple'
  pod 'HopSDK', :path => '../../../../sdk/apple'

  # The driver and the two modules that live inside its package.
  pod 'HopDriver', :path => '../../../../drivers/apple/HopDriver'
  pod 'HopObjC', :path => '../../../../drivers/apple/HopDriver'
  pod 'HopFFIBindings', :path => '../../../../drivers/apple/HopDriver'

  # The five bearers, each its own independent package, so a host links only the transports it wants.
  pod 'HopBearerBle', :path => '../../../../bearers/apple/HopBearerBle'
  pod 'HopBearerLan', :path => '../../../../bearers/apple/HopBearerLan'
  pod 'HopBearerMultipeer', :path => '../../../../bearers/apple/HopBearerMultipeer'
  pod 'HopBearerRelay', :path => '../../../../bearers/apple/HopBearerRelay'
  pod 'HopBearerMeshtastic', :path => '../../../../bearers/apple/HopBearerMeshtastic'

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
