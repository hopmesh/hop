# copy.bara.sky - mirror every first-party component subtree to its own standalone public repo.
#
# The Hop monorepo is the SOURCE OF TRUTH. Copybara replays each subtree OUT to its mirror commit-for-
# commit (export) and brings external PRs BACK as monorepo PRs (import), so a component can live in its
# own repo (its package page, issues, PRs) without forking. This is the Meta react-native / relay
# pattern, done with Copybara instead of fbshipit.
#
# Each component gets two workflows named "<mirror>_export" and "<mirror>_import" (e.g. hop-sdk-node_export),
# generated by the loop below. The Action (.github/workflows/sync-components.yml) picks one by name.
#
#   export : monorepo:<prefix>  ->  hopmesh/<mirror>   (prefix stripped, subtree becomes the mirror root)
#   import : <mirror> PR         ->  monorepo PR         (prefix re-added, opened for review, never a push)
#
# See tools/copybara/README.md for the one-time bootstrap + how the first (--init-history) run works.

MONOREPO = "https://github.com/hopmesh/hop.git"
BOT = "hop-sync <sync@hopme.sh>"

# (monorepo subtree prefix, standalone repo name). SDKs are Apache-2.0; core/services/bearers/drivers
# are FSL-1.1-ALv2. All public. Keep this list in sync with tools/copybara/bootstrap-mirrors.sh and
# docs/repo-catalog.md.
COMPONENTS = [
    ("sdk/node", "hop-sdk-node"),
    ("sdk/python", "hop-sdk-python"),
    ("sdk/go", "hop-sdk-go"),
    ("sdk/ruby", "hop-sdk-ruby"),
    ("sdk/crystal", "hop-sdk-crystal"),
    ("sdk/elixir", "hop-sdk-elixir"),
    ("sdk/apple", "hop-sdk-apple"),
    ("sdk/android", "hop-sdk-android"),
    ("core/hop-core", "hop-core"),
    ("core/hop", "libhop"),
    ("core/hop-wasm", "hop-wasm"),
    ("core/stores/hop-store-sqlite", "hop-store-sqlite"),
    ("core/stores/hop-store-firestore", "hop-store-firestore"),
    ("bearers/apple", "hop-bearers-apple"),
    ("bearers/android", "hop-bearers-android"),
    ("drivers/apple/HopDriver", "hop-driver-apple"),
    ("drivers/android/hop-driver", "hop-driver-android"),
    ("services/hop-relayd", "hop-relayd"),
    ("services/hop-endpoint", "hop-endpoint"),
    ("services/hop-gateway", "hop-gateway"),
]

def mirror_url(name):
    return "https://github.com/hopmesh/" + name + ".git"

# CLAUDE.md is monorepo-internal agent/dev guidance: it references the monorepo layout and sibling paths,
# so it is kept OUT of the public mirror (and can never be rewritten back in by an import). A scrubbed,
# standalone-appropriate CLAUDE.md that references the split repos directly is a follow-up, gated on
# validating the rewrite transforms against a real Copybara run.
def internal_files(prefix):
    return [prefix + "/CLAUDE.md"]

for prefix, name in COMPONENTS:
    internal = internal_files(prefix)
    core.workflow(
        name = name + "_export",
        origin = git.origin(url = MONOREPO, ref = "main"),
        destination = git.destination(url = mirror_url(name), push = "main"),
        # Only this subtree travels out, minus the internal files.
        origin_files = glob([prefix + "/**"], exclude = internal),
        destination_files = glob(["**"]),
        authoring = authoring.pass_thru(default = BOT),
        # ITERATIVE replays every monorepo commit that touches the subtree as its OWN commit in the
        # mirror. The first run is seeded once with --init-history (see the sync workflow's init input).
        mode = "ITERATIVE",
        transformations = [
            # Strip the monorepo prefix so <prefix>/** becomes the mirror's root.
            core.move(prefix, ""),
        ],
    )
    core.workflow(
        name = name + "_import",
        # A PR opened on the mirror (public discussion) becomes a PR on the monorepo, where it is merged
        # (main is branch-protected, so NEVER a direct push). The export then cascades the merge back out
        # as a push, which does not fire PR events, so the round trip cannot loop.
        origin = git.github_pr_origin(url = mirror_url(name), branch = "main"),
        destination = git.github_pr_destination(
            url = MONOREPO,
            destination_ref = "main",
            pr_branch = "copybara/import/" + name,
        ),
        origin_files = glob(["**"]),
        # The change lands ONLY under this subtree, and never rewrites the monorepo-internal files.
        destination_files = glob([prefix + "/**"], exclude = internal),
        authoring = authoring.pass_thru(default = BOT),
        mode = "CHANGE_REQUEST",
        transformations = [
            # Re-add the prefix so the mirror's root maps back under <prefix>.
            core.move("", prefix),
        ],
    )
