# copy.bara.sky - mirror every first-party component subtree to its own standalone public repo.
#
# The Hop monorepo is the SOURCE OF TRUTH. Copybara replays each subtree OUT to its mirror commit-for-
# commit (export) and brings external PRs BACK as monorepo PRs (import), so a component can live in its
# own repo (its package page, issues, PRs) without forking. This is the Meta react-native / relay
# pattern, done with Copybara instead of fbshipit.
#
# Each component gets two workflows named "<mirror>_export" and "<mirror>_import" (e.g. hop-sdk-node_export),
# generated by the loop below. The Action (.github/workflows/sync-components.yml) picks one by name.
#
#   export : monorepo:<prefix>  ->  hopmesh/<mirror>   (prefix stripped, subtree becomes the mirror root)
#   import : <mirror> PR         ->  monorepo PR         (prefix re-added, opened for review, never a push)
#
# See tools/copybara/README.md for the one-time bootstrap + how the first (--init-history) run works.

MONOREPO = "https://github.com/hopmesh/monorepo.git"
BOT = "hop-sync <sync@hopme.sh>"
PROVENANCE_HELPER = "tools/release-provenance.py"
RELEASE_ARTIFACT_HELPER = "tools/release-artifact.py"
CRATES_PUBLISH_HELPER = "tools/crates-publish.py"
COMPONENT_MAP = "tools/copybara/components.json"
EXPORT_SMOKE = "tools/package-export-smoke.py"
NATIVE_HELPER = "tools/native-artifacts.py"
NATIVE_SCHEMA = "tools/native-artifacts.schema.json"
NATIVE_PUBLIC_KEY = "tools/native-artifacts-public.pem"
HOP_HEADER = "sdk/hop.h"
ELIXIR_WORKSPACE = "tools/copybara/elixir-native-Cargo.toml"
ELIXIR_LOCK = "tools/copybara/elixir-native-Cargo.lock"

# (monorepo subtree prefix, standalone repo name). services/* are FSL-1.1-ALv2; core, SDKs, bearers and
# drivers are Apache-2.0. All public. (This comment previously claimed core/services/bearers/drivers
# were all FSL, which was never true of bearers or drivers and stopped being true of core with the
# 2026-07-31 tier inversion. tools/repo-integrity-guard.sh is the enforced source of truth.)
# Keep this list in sync with tools/copybara/bootstrap-mirrors.sh and docs/repo-catalog.md.
COMPONENTS = [
    ("sdk/go", "hop-sdk-go"),
    ("sdk/crystal", "hop-sdk-crystal"),
    ("sdk/apple", "hop-sdk-apple"),
]

def mirror_url(name):
    return "https://github.com/hopmesh/" + name + ".git"

# CLAUDE.md is monorepo-internal agent/dev guidance: it references the monorepo layout and sibling paths,
# so it is kept OUT of the public mirror (and can never be rewritten back in by an import). A scrubbed,
# standalone-appropriate CLAUDE.md that references the split repos directly is a follow-up, gated on
# validating the rewrite transforms against a real Copybara run.
def internal_files(prefix):
    return [prefix + "/CLAUDE.md"]

# The Rust crate mirrors. Each crate's Cargo.toml inherits version/edition/repository and its external
# deps from the monorepo [workspace.*] tables and depends on sibling crates by path, none of which exist
# in a standalone single-crate mirror, so `cargo`/`wasm-pack` cannot resolve it. On export we inject a
# self-contained [workspace] preamble that supplies those tables, with the inter-crate deps rewritten to
# their crates.io VERSIONS (Jason's call: crates.io version deps, not git or a collapsed workspace). cargo
# resolves the `.workspace = true` inheritance into concrete values at publish time, so the manifest that
# lands on crates.io is clean. The import direction strips the preamble back out so a mirror PR never
# writes it into the monorepo. hop-core is a leaf (publishes first); libhop/services also pull
# hop-endpoint-core (core/hop-endpoint), which is not mirrored yet, so they only fully build once it is
# published too. KEEP THIS PREAMBLE IN SYNC WITH THE ROOT Cargo.toml: tools/version-align-guard.sh checks
# the version line against the workspace anchor.
RUST_MIRRORS = [
    # None of the surviving mirrors is a Rust crate. The Rust crates publish from the
    # monorepo now; see the retirement note above.
]

# crates.io CRATE NAMES: `hop-core` and `hop` are already taken on crates.io by an unrelated project, so
# the published crates use the hop-mesh-* convention (matches the @hop-mesh npm scope; all free). This is a
# PUBLISH-NAME-ONLY rename applied to the mirror: the monorepo keeps hop-core/hop/... and consumer Rust
# code keeps `use hop_core` because the preamble deps above alias via `package = "hop-mesh-*"` (the dep KEY,
# not the published name, is the extern-crate name). Mirror repo names are unchanged; only the crates.io
# package differs. Map: mirror -> (monorepo [package] name, crates.io name). Crates not listed keep their
# name (hop-wasm publishes to npm; the services are binaries, not crates.io crates).
CRATE_RENAMES = {
    # Empty for the same reason as RUST_MIRRORS: no Rust crate mirrors survive.
}

# Native wrappers receive the same verifier, schema, and public signing key. Release jobs download the
# canonical native-artifacts workflow output by immutable run and artifact ID, then this verifier checks
# the signed manifest, target, archive inventory, size, and digest before any extraction.
NATIVE_COMPONENTS = ["hop-sdk-go", "hop-sdk-apple"]

# Go uses monorepo-relative header and target paths while it is in this tree. The public module keeps a
# standalone hop.h contract and resolves the installed header and library through the versioned hop.pc.
GO_CGO_MONOREPO = """#cgo CFLAGS: -I$${SRCDIR}/..
#cgo LDFLAGS: -L$${SRCDIR}/../../target/debug -lhop -Wl,-rpath,$${SRCDIR}/../../target/debug -Wl,-rpath,$${SRCDIR}/../../target/debug/deps
"""
GO_CGO_EXPORT = """#cgo pkg-config: hop
"""

def _go_export_paths():
    return core.replace(
        before = GO_CGO_MONOREPO,
        after = GO_CGO_EXPORT,
        paths = glob(["hop.go"]),
        first_only = True,
        multiline = True,
    )

def _go_import_paths():
    return core.replace(
        before = GO_CGO_EXPORT,
        after = GO_CGO_MONOREPO,
        paths = glob(["hop.go"]),
        first_only = True,
        multiline = True,
    )

# The Hex package vendors the four Rust crates needed by its Rustler NIF. This avoids an unpublished
# path dependency and keeps every Rust source file under native/vendor, inside Hex's package checksum.
ELIXIR_HOP_PATH_DEP = """hop = { path = "../../../../core/hop" }

[workspace]
"""
ELIXIR_HOP_VENDOR_DEP = 'hop = { workspace = true }\n'

def _elixir_vendor_export():
    return [
        core.move(ELIXIR_WORKSPACE, "native/Cargo.toml"),
        core.move("core/hop-core", "native/vendor/hop-core"),
        core.move("core/hop-endpoint", "native/vendor/hop-endpoint-core"),
        core.move("core/stores/hop-store-sqlite", "native/vendor/hop-store-sqlite"),
        core.move("core/hop", "native/vendor/libhop"),
        core.move(ELIXIR_LOCK, "native/Cargo.lock"),
        core.replace(
            before = ELIXIR_HOP_PATH_DEP,
            after = ELIXIR_HOP_VENDOR_DEP,
            paths = glob(["native/hop_endpoint/Cargo.toml"]),
            first_only = True,
            multiline = True,
        ),
    ]

def _elixir_vendor_import():
    return core.replace(
        before = ELIXIR_HOP_VENDOR_DEP,
        after = ELIXIR_HOP_PATH_DEP,
        paths = glob(["native/hop_endpoint/Cargo.toml"]),
        first_only = True,
        multiline = True,
    )

# Rewrite the mirror's [package] name to its crates.io name (export) and back (import). Anchored on
# "[package]\\nname = ..." so it targets the package section, never a [lib]/[[bin]] name or a dep.
def _rename_pkg(old, new):
    return core.replace(
        before = '[package]\nname = "' + old + '"\n',
        after = '[package]\nname = "' + new + '"\n',
        paths = glob(["Cargo.toml"]),
        first_only = True,
        multiline = True,
    )

WORKSPACE_PREAMBLE = """# --- injected for the standalone mirror by tools/copybara/copy.bara.sky ---
[workspace]
resolver = "2"

[workspace.package]
version = "0.0.2"
edition = "2021"
repository = "https://github.com/hopmesh/monorepo"

[workspace.dependencies]
hop-core = { version = "0.0.2", package = "hop-mesh-core" }
hop-endpoint-core = { version = "0.0.2", package = "hop-mesh-endpoint-core" }
hop-store-sqlite = { version = "0.0.2", default-features = false, package = "hop-mesh-store-sqlite" }
hop-store-firestore = { version = "0.0.2", package = "hop-mesh-store-firestore" }
serde = { version = "1", features = ["derive"] }
postcard = { version = "1", features = ["use-std"] }
blake3 = "1"
sha2 = "0.11"
ed25519-dalek = { version = "3", features = ["rand_core"] }
x25519-dalek = { version = "3", features = ["static_secrets"] }
chacha20poly1305 = "0.11"
rand_core = { version = "0.6", features = ["getrandom"] }
thiserror = "2"
miniz_oxide = "0.9"
snow = "0.10"
rusqlite = { version = "0.40", features = ["bundled"] }
# --- end injected preamble ---
[package]
"""

# core.replace is single-line by default; the preamble spans newlines, so multiline is required. Anchored
# on the crate's first "[package]\\n"; a mirror with no Cargo.toml (the non-Rust SDKs) matches nothing.
def _inject_workspace():
    return core.replace(
        before = "[package]\n",
        after = WORKSPACE_PREAMBLE,
        paths = glob(["Cargo.toml"]),
        first_only = True,
        multiline = True,
    )

def _strip_workspace():
    return core.replace(
        before = WORKSPACE_PREAMBLE,
        after = "[package]\n",
        paths = glob(["Cargo.toml"]),
        first_only = True,
        multiline = True,
    )

# The preamble is shared by every Rust mirror, so it can only name one repository, and it names the
# monorepo. That is wrong twice over on a published artifact: the monorepo is PRIVATE, so the link is
# dead for anyone who installs the package, and npm REJECTS a package whose repository does not match
# the one its sigstore provenance attests to:
#   Failed to validate repository information: package.json: "repository.url" is "...",
#   expected to match "https://github.com/hopmesh/hop-wasm" from provenance
# hop-wasm publishes to npm from its own mirror and would fail exactly that, the same way hop-sdk-node
# already did. So rewrite the shared value to each crate's OWN mirror on export, and reverse it on
# import before the preamble is stripped (the strip matches the preamble verbatim).
MONOREPO_REPOSITORY = 'repository = "https://github.com/hopmesh/monorepo"'

def _mirror_repository(name):
    return core.replace(
        before = MONOREPO_REPOSITORY,
        after = 'repository = "https://github.com/hopmesh/' + name + '"',
        paths = glob(["Cargo.toml"]),
        first_only = True,
    )

def _monorepo_repository(name):
    return core.replace(
        before = 'repository = "https://github.com/hopmesh/' + name + '"',
        after = MONOREPO_REPOSITORY,
        paths = glob(["Cargo.toml"]),
        first_only = True,
    )

# Copybara's Starlark forbids top-level for loops, so register each component's two workflows from a
# function, invoked once per component by the comprehension at the end of the file.
def _register(prefix, name):
    internal = internal_files(prefix)
    is_rust = name in RUST_MIRRORS
    is_elixir = name == "hop-sdk-elixir"
    is_native = name in NATIVE_COMPONENTS
    carries_header = name in ["hop-sdk-go", "hop-sdk-android"]
    rename = CRATE_RENAMES.get(name)  # (old, new) crates.io package name, or None
    # export: strip the prefix, then (Rust only) rename the crates.io package + inject the [workspace]
    # preamble. Rename BEFORE inject so it anchors on the original "[package]\nname" at the file top.
    export_transforms = [
        core.move(prefix, ""),
        core.move(PROVENANCE_HELPER, ".github/release-provenance.py"),
        core.move(RELEASE_ARTIFACT_HELPER, ".github/release-artifact.py"),
        core.move(COMPONENT_MAP, ".github/components.json"),
        core.move(EXPORT_SMOKE, ".github/package-export-smoke.py"),
    ]
    if is_native:
        export_transforms.extend([
            core.move(NATIVE_HELPER, "native/native-artifacts.py"),
            core.move(NATIVE_SCHEMA, "native/native-artifacts.schema.json"),
            core.move(NATIVE_PUBLIC_KEY, "native/native-artifacts-public.pem"),
        ])
    if is_rust:
        export_transforms.append(core.move(CRATES_PUBLISH_HELPER, ".github/crates-publish.py"))
    if name == "hop-sdk-go":
        export_transforms.append(core.move(HOP_HEADER, "hop.h"))
    if name == "hop-sdk-android":
        export_transforms.append(core.move(HOP_HEADER, "include/hop.h"))
    if rename:
        export_transforms.append(_rename_pkg(rename[0], rename[1]))
    if is_rust:
        export_transforms.append(_inject_workspace())
        export_transforms.append(_mirror_repository(name))
    if is_elixir:
        export_transforms.extend(_elixir_vendor_export())
    if name == "hop-sdk-go":
        export_transforms.append(_go_export_paths())
    # import: reverse order: strip the preamble, un-rename the package, then re-add the prefix.
    import_transforms = []
    if is_rust:
        # Undo the per-mirror repository BEFORE stripping, or the preamble no longer matches verbatim.
        import_transforms.append(_monorepo_repository(name))
        import_transforms.append(_strip_workspace())
    if rename:
        import_transforms.append(_rename_pkg(rename[1], rename[0]))
    if is_elixir:
        import_transforms.append(_elixir_vendor_import())
    if name == "hop-sdk-go":
        import_transforms.append(_go_import_paths())
    import_transforms.append(core.move("", prefix))
    origin_paths = [
        prefix + "/**",
        PROVENANCE_HELPER,
        RELEASE_ARTIFACT_HELPER,
        COMPONENT_MAP,
        EXPORT_SMOKE,
    ]
    if is_native:
        origin_paths.extend([NATIVE_HELPER, NATIVE_SCHEMA, NATIVE_PUBLIC_KEY])
    if is_rust:
        origin_paths.append(CRATES_PUBLISH_HELPER)
    if carries_header:
        origin_paths.append(HOP_HEADER)
    if is_elixir:
        origin_paths.extend([
            ELIXIR_WORKSPACE,
            ELIXIR_LOCK,
            "core/hop-core/**",
            "core/hop-endpoint/**",
            "core/stores/hop-store-sqlite/**",
            "core/hop/**",
        ])
    export_excludes = internal[:]
    if is_elixir:
        export_excludes.extend([
            prefix + "/native/hop_endpoint/Cargo.lock",
            "core/hop-core/CLAUDE.md",
            "core/hop-endpoint/CLAUDE.md",
            "core/stores/hop-store-sqlite/CLAUDE.md",
            "core/hop/CLAUDE.md",
        ])
    import_excludes = [
        ".github/release-provenance.py",
        ".github/release-artifact.py",
        ".github/components.json",
        ".github/package-export-smoke.py",
    ]
    if is_native:
        import_excludes.extend([
            "native/native-artifacts.py",
            "native/native-artifacts.schema.json",
            "native/native-artifacts-public.pem",
        ])
    if is_rust:
        import_excludes.append(".github/crates-publish.py")
    if name == "hop-sdk-go":
        import_excludes.append("hop.h")
    if name == "hop-sdk-android":
        import_excludes.append("include/hop.h")
    if is_elixir:
        import_excludes.extend(["native/Cargo.toml", "native/Cargo.lock", "native/vendor/**"])
    core.workflow(
        name = name + "_export",
        origin = git.origin(url = MONOREPO, ref = "main"),
        destination = git.destination(url = mirror_url(name), push = "main"),
        # Only this subtree travels out, minus the internal files.
        origin_files = glob(
            origin_paths,
            exclude = export_excludes,
        ),
        destination_files = glob(["**"]),
        authoring = authoring.pass_thru(default = BOT),
        # ITERATIVE replays every monorepo commit that touches the subtree as its OWN commit in the
        # mirror. The first run is seeded once with --init-history (see the sync workflow's init input).
        mode = "ITERATIVE",
        transformations = export_transforms,
    )
    core.workflow(
        name = name + "_import",
        # A PR opened on the mirror (public discussion) becomes a PR on the monorepo, where it is merged
        # (main is branch-protected, so NEVER a direct push). The export then cascades the merge back out
        # as a push, which does not fire PR events, so the round trip cannot loop.
        origin = git.github_pr_origin(url = mirror_url(name), branch = "main"),
        destination = git.github_pr_destination(
            url = MONOREPO,
            destination_ref = "main",
            pr_branch = "copybara/import/" + name,
        ),
        origin_files = glob(
            ["**"],
            exclude = import_excludes,
        ),
        # The change lands ONLY under this subtree, and never rewrites the monorepo-internal files.
        destination_files = glob([prefix + "/**"], exclude = internal),
        authoring = authoring.pass_thru(default = BOT),
        mode = "CHANGE_REQUEST",
        # Import transforms mirror the one-way export transforms, so the CHANGE_REQUEST reversibility
        # check does not apply to this directional sync (a directional migration, not an in-place edit).
        reversible_check = False,
        transformations = import_transforms,
    )

# This pinned Copybara runtime does not support tuple-unpacking comprehensions. Keep these explicit
# registrations in the same order as COMPONENTS; dispatch.test.sh rejects drift between them.
REGISTERED = [
    _register("sdk/go", "hop-sdk-go"),
    _register("sdk/crystal", "hop-sdk-crystal"),
    _register("sdk/apple", "hop-sdk-apple"),
]

# ---------------------------------------------------------------------------------------------------
# THE SPLIT: two whole-repo workflows, distinct from the per-component mirrors above.
#
# Everything above exports a SUBTREE and makes it a mirror's root. These two export the repository AS a
# repository, prefixes intact, and exist for the one-time reorganisation:
#
#   internal_export  the trees that must NOT ship with public source, into a private repo
#   public_export    everything else, into the public repo
#
# Both are ONE-TIME migrations seeded with --init-history, not standing syncs. That distinction is the
# whole point for internal_export: a standing sync would leave docs/audits and business/ present in BOTH
# repos and in the public repo's history forever, which is exactly what moving them is meant to prevent.
# Run it once, delete the trees from the monorepo in a normal commit, and let public_export's
# --init-history do the rest: a commit that only ever touched an excluded path never appears in the
# exported history at all, so there is nothing to purge afterwards.

# The trees that stay private. Kept as one list so the two workflows cannot disagree about the boundary:
# public_export excludes exactly what internal_export includes.
PRIVATE_TREES = [
    "docs/audits/**",   # 28 files: the dated adversarial-audit corpus, immutable point-in-time reports
    "business/**",      # 4 files: pitch-deck plan and pricing/packaging strategy
]

INTERNAL_REPO = "https://github.com/hopmesh/internal.git"

# The public repository. NOT hopmesh/hop: that name is a rename redirect to hopmesh/monorepo (same repo
# id), so claiming it would break the redirect. Set this to the agreed name before the first run; the
# bootstrap refuses to run against a placeholder.
PUBLIC_REPO = "https://github.com/hopmesh/hop.git"

core.workflow(
    name = "internal_export",
    origin = git.origin(url = MONOREPO, ref = "main"),
    destination = git.destination(url = INTERNAL_REPO, push = "main"),
    # Paths are NOT stripped: docs/audits/ lands at docs/audits/ so every F-xx reference that survives
    # in the public tree still names a path a reader can find, just in a repo they need access to.
    origin_files = glob(PRIVATE_TREES),
    destination_files = glob(["**"]),
    authoring = authoring.pass_thru(default = BOT),
    mode = "ITERATIVE",
)

core.workflow(
    name = "public_export",
    origin = git.origin(url = MONOREPO, ref = "main"),
    destination = git.destination(url = PUBLIC_REPO, push = "main"),
    # The whole repository minus the private trees. Excluded here means excluded from HISTORY too under
    # --init-history, which is why this replaces a git filter-repo rewrite: nothing is rewritten, the
    # commits simply never carry those paths, and the monorepo is left untouched as the archive.
    origin_files = glob(["**"], exclude = PRIVATE_TREES),
    destination_files = glob(["**"]),
    authoring = authoring.pass_thru(default = BOT),
    mode = "ITERATIVE",
)
