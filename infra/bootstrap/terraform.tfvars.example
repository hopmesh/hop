# Store the finished file in the BOOTSTRAP_TFVARS repository secret as well. That secret is what
# .github/workflows/bootstrap-apply.yml writes to ci.auto.tfvars, and dispatching that workflow is the
# only supported way to apply this root. Never run `tofu apply` here from a terminal.

# Scopes the github-actions WIF provider condition and the bootstrap-apply / runtime-deploy OIDC
# subjects, plus billing-catalog impersonation.
github_repository = "hopmesh/monorepo"

# Pin the current versions after seeding each secret out of band.
relay_identity_version   = "1"
example_identity_version = "1"

deployment_environment = "production"
runtime_state_bucket   = "hop-mesh-tfstate"
firestore_location     = "nam5"

# The relay fleet remains off during the P2P-only phase. Changing this control-plane
# value requires a separately reviewed bootstrap apply.
relays_enabled = false
