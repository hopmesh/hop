# Terraform
.terraform/
# NOTE (infra-11): .terraform.lock.hcl is deliberately COMMITTED (not ignored) so provider
# versions are pinned + identical between every CI validate, local run, and the Cloud Build
# apply. Do not re-add it here. Update it with `tofu providers lock` when bumping a provider.
*.tfstate
*.tfstate.*
crash.log
crash.*.log
terraform.tfvars
*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Spacelift OIDC federation config: regenerated by bootstrap, mounted in the stack
# never commit GCP service-account key files
*-sa-key.json
*serviceaccount*.json
