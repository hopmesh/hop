# Copy to terraform.tfvars (gitignored) or set these as Spacelift stack variables.

project_id = "hop-mesh"

# Build & push first, then paste the immutable tag here (see infra/README.md).
relay_image = "us-central1-docker.pkg.dev/hop-mesh/hop/hop-relayd:latest"

# Trim or extend to the continents you want entrances in.
regions = ["us-central1", "europe-west1", "asia-southeast1"]

domain = "relay.hopme.sh"

# Leave false until hopme.sh DNS is delegated to Cloud DNS.
manage_dns = false
