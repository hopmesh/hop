<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- BLE permissions. SCAN/ADVERTISE/CONNECT are the Android 12+ model. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Pre-Android-12 fallbacks. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Fine location: BLE caps it at 30 (neverForLocation), but Wi-Fi Direct service discovery
         needs it through Android 12L (API 32); 13+ uses NEARBY_WIFI_DEVICES below. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <!-- LAN bearer (mDNS/NSD + TCP) and Wi-Fi Direct bearer: discover and link nearby devices
         over Wi-Fi — on a shared network (NSD) or peer-to-peer with no router (Wi-Fi Direct). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />
    <uses-feature android:name="android.hardware.wifi.direct" android:required="false" />

    <!-- Keep BLE alive in the background via a foreground service (DESIGN.md §22). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Local notifications ("push") for delivered messages, Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Cloud relay bearer (TCP/WebSocket to hop-relayd over the internet). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="Hop Debug"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".HopService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
