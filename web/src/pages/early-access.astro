---
import Base from '../layouts/Base.astro';
---
<Base
  title="Early access — register interest in Hop"
  description="Hop is in early access. Tell us what you're building and we'll get you in — SDK, hosted backbone, the long-range Hop Bridge, or a partnership."
  path="/early-access"
>
  <section class="hero" style="padding-bottom:24px;">
    <div class="wrap">
      <div class="eyebrow">Early access</div>
      <h1>Get on the <span style="color:var(--accent)">list.</span></h1>
      <p class="lede">We're not open to everyone yet — we're onboarding teams in early access. Tell us
         what you're building and we'll reach out as access opens up.</p>
    </div>
  </section>

  <section class="band" style="padding-top:8px;">
    <div class="wrap" style="max-width:680px;">
      <div class="card" style="padding:clamp(22px,3vw,34px);">
        <form id="lead-form" class="lead-form" novalidate>
          <div class="field">
            <label for="lf-name">Name</label>
            <input id="lf-name" name="name" type="text" autocomplete="name" placeholder="Jane Doe" />
          </div>
          <div class="field">
            <label for="lf-email">Email <span class="req">*</span></label>
            <input id="lf-email" name="email" type="email" required autocomplete="email" placeholder="you@company.com" />
          </div>
          <div class="field">
            <label for="lf-company">Company or project</label>
            <input id="lf-company" name="company" type="text" placeholder="What you're with" />
          </div>
          <div class="field">
            <label for="lf-interest">Primary interest</label>
            <select id="lf-interest" name="interest">
              <option>SDK — building an app</option>
              <option>Hosted cloud backbone</option>
              <option>Hop Bridge — long-range hardware</option>
              <option>Public safety &amp; defense</option>
              <option>Partnership or other</option>
            </select>
          </div>
          <div class="field">
            <label for="lf-msg">What are you building?</label>
            <textarea id="lf-msg" name="message" rows="4" placeholder="A sentence or two on your use case and where you need Hop."></textarea>
          </div>
          <input type="hidden" name="access_key" value="fbe3defc-91cc-4129-9670-c18ebdce20d7" />
          <input type="hidden" name="subject" value="Hop early-access interest" />
          <input type="hidden" name="from_name" value="Hop early access" />
          {/* honeypot — bots tick this; humans never see it (Web3Forms rejects if set) */}
          <input type="checkbox" name="botcheck" class="lf-hp" tabindex="-1" aria-hidden="true" />
          <button class="btn btn-primary" type="submit" id="lf-submit">Request early access →</button>
          <p class="lead-note" id="lf-status" role="status" aria-live="polite"></p>
        </form>
      </div>
      <p class="note mt-m">Prefer email? Write <a href="mailto:hello@hopme.sh?subject=Hop%20early-access%20interest">hello@hopme.sh</a>.
         We use what you send only to follow up about access.</p>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    // Web3Forms — submissions POST here with the public access_key field above and are
    // emailed to the address configured on the Web3Forms account. (If ever cleared, the
    // form falls back to composing an email to hello@hopme.sh so the button still works.)
    var FORM_ENDPOINT = 'https://api.web3forms.com/submit';

    var f = document.getElementById('lead-form');
    if (!f) return;
    var status = document.getElementById('lf-status');
    var submit = document.getElementById('lf-submit');

    f.addEventListener('submit', function (e) {
      e.preventDefault();
      if (f.botcheck && f.botcheck.checked) return; // bot
      var data = new FormData(f);
      var email = (data.get('email') || '').trim();
      if (!email || email.indexOf('@') < 1) {
        status.className = 'lead-note err';
        status.textContent = 'Please enter a valid email.';
        return;
      }

      if (!FORM_ENDPOINT) {
        // No backend wired yet — fall back to an email compose.
        var body = 'Name: ' + (data.get('name') || '') +
          '\nCompany: ' + (data.get('company') || '') +
          '\nInterest: ' + (data.get('interest') || '') +
          '\n\n' + (data.get('message') || '');
        window.location.href = 'mailto:hello@hopme.sh?subject=Hop%20early-access%20interest&body=' + encodeURIComponent(body);
        status.className = 'lead-note';
        status.textContent = 'Opening your email app…';
        return;
      }

      submit.disabled = true;
      status.className = 'lead-note';
      status.textContent = 'Sending…';
      fetch(FORM_ENDPOINT, { method: 'POST', body: data, headers: { Accept: 'application/json' } })
        .then(function (r) {
          if (r.ok) {
            f.style.display = 'none';
            status.className = 'lead-note ok';
            status.textContent = "Thanks — you're on the list. We'll be in touch as access opens.";
          } else {
            throw new Error('bad status');
          }
        })
        .catch(function () {
          submit.disabled = false;
          status.className = 'lead-note err';
          status.textContent = "Something went wrong — please email hello@hopme.sh and we'll add you.";
        });
    });
  })();
</script>
