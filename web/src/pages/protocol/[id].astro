---
import Base from '../../layouts/Base.astro';
import ProtocolDiagram from '../../components/ProtocolDiagram.astro';
import { layers } from '../../data/protocol.js';

export function getStaticPaths() {
  return layers.map((l, i) => ({
    params: { id: l.id },
    props: { l, prev: layers[(i - 1 + layers.length) % layers.length], next: layers[(i + 1) % layers.length] },
  }));
}
const { l, prev, next } = Astro.props;
const plain = l.name.replace(/&amp;/g, '&');
const tagline = l.tagline.replace(/<[^>]*>/g, '');
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<Base
  title={`${plain}, Hop protocol`}
  description={`${plain}: ${l.tagline}. Part of the Hop ${l.group.toLowerCase()} layer.`}
  path="/protocol"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@graph': [
      { '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://hopme.sh/' },
        { '@type': 'ListItem', position: 2, name: 'Protocol', item: 'https://hopme.sh/protocol/' },
        { '@type': 'ListItem', position: 3, name: plain, item: canonical },
      ]},
      { '@type': 'TechArticle', headline: `${plain}, Hop protocol`, description: `${plain}: ${tagline}.`,
        url: canonical, isPartOf: { '@id': 'https://hopme.sh/#website' }, publisher: { '@id': 'https://hopme.sh/#org' } },
    ],
  })} />

  <section class="hero" style="padding-bottom:24px;">
    <div class="wrap">
      <div class="eyebrow"><a href="/protocol/" style="color:var(--accent)">Protocol</a> · {l.group}</div>
      <h1 class:list={[{ mono: l.mono }]} style="max-width:20ch;" set:html={l.name}></h1>
      <p class="lede" style="margin-top:14px;" set:html={l.tagline}></p>
    </div>
  </section>

  <section class="band" style="padding-top:8px;">
    <div class="wrap">
      {l.viz && <ProtocolDiagram viz={l.viz} />}

      <div class="grid-2" style="margin-top:44px; align-items:start; gap:44px;">
        <div>
          <div class="kicker">How it works</div>
          <ul class="checks" style="margin-top:16px;">
            {l.how.map((p) => <li set:html={p}></li>)}
          </ul>
        </div>
        <div>
          <div class="kicker">Why it matters</div>
          <div class="card" style="margin-top:16px;">
            <div class="kicker" style="color:var(--accent);">For developers</div>
            <p style="margin-top:8px; font-size:14.5px;" set:html={l.dev}></p>
          </div>
          <div class="card" style="margin-top:14px;">
            <div class="kicker" style="color:var(--accent);">For business</div>
            <p style="margin-top:8px; font-size:14.5px;" set:html={l.biz}></p>
          </div>
        </div>
      </div>

      <p class="note" style="margin-top:36px;">Deeper implementation detail is coming in the Hop whitepaper.</p>

      <div class="prevnext" style="display:flex;justify-content:space-between;gap:16px;margin-top:28px;border-top:1px solid var(--line-soft);padding-top:22px;">
        <a class="link-go" href={`/protocol/${prev.id}/`}>← <span set:html={prev.name}></span></a>
        <a class="link-go" href={`/protocol/${next.id}/`}><span set:html={next.name}></span> →</a>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <h2>Ready to build on it?</h2>
      <div class="hero-cta">
        <a class="btn btn-primary" href="/docs/quickstart/">Quickstart →</a>
        <a class="btn btn-ghost" href="/protocol/">All layers</a>
      </div>
    </div>
  </section>
</Base>
