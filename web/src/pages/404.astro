---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Hop" description="That page took a hop too far." path="">
  <section class="hero" style="text-align:center;">
    <div class="wrap">
      <div class="eyebrow" style="justify-content:center;">404</div>
      <h1>This one didn't <span class="grad">find a way.</span></h1>
      <p class="lede" style="margin-left:auto;margin-right:auto;">
        The page you're after isn't here — it may have moved, or never existed. Let's get
        you back on the network.
      </p>
      <div class="hero-cta" style="justify-content:center;">
        <a class="btn btn-primary" href="/">Back home</a>
        <a class="btn btn-ghost" href="/developers/">Developers</a>
      </div>
    </div>
  </section>
</Base>
