---
// Site header. `path` is the current route so the active nav link can be marked.
const { path = '' } = Astro.props;
const is = (p) => (path === p ? 'nav-link active' : 'nav-link');
---
<header class="site-hdr">
  <div class="wrap">
    <a class="brand" href="/"><span class="mark">⇢</span><span>hop</span></a>
    <nav class="site-nav">
      <a class={is('/use-cases')} href="/use-cases/">Use cases</a>
      <a class={is('/developers')} href="/developers/">Developers</a>
      <a class={is('/business')} href="/business/">Business</a>
      <a class={is('/pricing')} href="/pricing/">Pricing</a>
      <a class="btn btn-primary btn-sm" href="/quickstart/">Quickstart</a>
    </nav>
  </div>
</header>
