---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Base page shell. Props: title, description (meta), and path (for active nav).
const {
  title = 'Hop, the network that finds a way',
  description = 'Hop is a delay-tolerant mesh network for intermittently-connected devices. End-to-end encrypted messages relay device to device, over BLE, Wi-Fi, and the internet, until they reach the person you’re trying to reach.',
  path = '',
  ogImage = '/og.png',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    {/* Set theme before paint, stored choice, else OS pref, else dark. */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('hop-theme');
          if (t !== 'light' && t !== 'dark') {
            t = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          }
          document.documentElement.setAttribute('data-theme', t);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#07090b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    {/* Brand typeface, Poppins (geometric, friendly, pairs with the cursive mark).
        web-r2-04: self-hosted under /public/fonts (CSS + woff2), so there is no
        unpinned third-party stylesheet on the site and no runtime dependency on
        fonts.googleapis.com / fonts.gstatic.com. Regenerate with tools if the weights change. */}
    <link rel="stylesheet" href="/fonts/poppins.css" />
    {/* Icons, Font Awesome Pro kit */}
    <script is:inline src="https://kit.fontawesome.com/8fa0df1cfb.js" crossorigin="anonymous"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Open Graph, social / link unfurls */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hop" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hop, the network that finds a way" />

    {/* Twitter / X large-image card */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {/* Structured data, Organization + the SDK as a SoftwareApplication */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          '@id': 'https://hopme.sh/#website',
          url: 'https://hopme.sh/',
          name: 'Hop',
          publisher: { '@id': 'https://hopme.sh/#org' },
        },
        {
          '@type': 'Organization',
          '@id': 'https://hopme.sh/#org',
          name: 'Hop',
          url: 'https://hopme.sh/',
          logo: 'https://hopme.sh/apple-touch-icon.png',
          description: 'Hop is a delay-tolerant mesh network, end-to-end encrypted, store-and-forward messages that find a way device to device over BLE, Wi-Fi, and the internet.',
        },
        {
          '@type': 'SoftwareApplication',
          name: 'Hop SDK',
          applicationCategory: 'DeveloperApplication',
          operatingSystem: 'iOS, Android',
          url: 'https://hopme.sh/',
          publisher: { '@id': 'https://hopme.sh/#org' },
          offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
          description: 'Embed the Hop delay-tolerant mesh transport in your app, sealed, store-and-forward datagrams that relay device to device over BLE, Wi-Fi, and the internet.',
        },
      ],
    })} />
  </head>
  <body>
    <Header path={path} />
    <slot />
    <Footer />
  </body>
</html>
