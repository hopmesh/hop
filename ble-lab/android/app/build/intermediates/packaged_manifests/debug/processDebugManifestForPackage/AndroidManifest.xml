<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="net.waldrip.blelab"
    android:versionCode="1"
    android:versionName="0.1.0" >

    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="34" />

    <!-- BLE permissions (Android 12+ model). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Pre-Android-12 fallbacks (API 29-30). -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- BLE scanning needed location through API 30 (neverForLocation caps at 30). -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <!-- Keep both BLE planes alive in the background via a foreground service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- Foreground-service notification, Android 13+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Restart the FGS after reboot + ask to be exempt from battery optimization. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="BLE Lab"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light" >
        <activity
            android:name="net.waldrip.blelab.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="net.waldrip.blelab.BleService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <receiver
            android:name="net.waldrip.blelab.BootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!--
             Self-resurrection watchdog: woken by an exact alarm to restart the anchor FGS so the
             iBeacon comes back and can wake a killed iOS peer. Triggered explicitly (no filter).
        -->
        <receiver
            android:name="net.waldrip.blelab.AnchorWatchdogReceiver"
            android:exported="false" />
    </application>

</manifest>